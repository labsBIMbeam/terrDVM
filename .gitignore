# Secrets and local configuration
.env
.env.*
!.env.example
*.key
*.pem
*.nsec

# Node
node_modules/
dist/
apps/napplet/dist/
.vite/
coverage/
# The test-coverage rule above must not swallow shipped survey data
!apps/napplet/src/config/coverage/
playwright-report/
test-results/

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]

# Runtime data and generated artifacts
.local/
data/
jobs/
artifacts/
*.glb
*.tif
*.tiff
*.png

# Keep deliberate test fixtures
!tests/fixtures/**/*.png
!tests/fixtures/**/*.tif
!tests/fixtures/**/*.tiff
!tests/fixtures/**/*.glb
!apps/napplet/tests/fixtures/**/*.png
!apps/napplet/tests/fixtures/**/*.tif
!apps/napplet/tests/fixtures/**/*.tiff
!apps/napplet/tests/fixtures/**/*.glb

# GSD clean-checkout and local scratch
.terrdvm-worktree*/
.scratch/
tmp/
.scratch/**/*.log
tmp/**/*.log

# Editors/OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
